# Order Service Configuration

# Database
DATABASE_URL=postgresql://pos_user:pos_password@postgres:5432/pos_db?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=pos_user
DB_PASSWORD=pos_password
DB_NAME=pos_db

# Redis
REDIS_URL=redis://:pos_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=pos_password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Service
PORT=8080
SERVICE_NAME=order-service

# Sessions
SESSION_TTL_HOURS=24
CART_TTL_HOURS=24
INVENTORY_RESERVATION_TTL_MINUTES=15
CART_SESSION_TTL=86400

# Logging
LOG_LEVEL=info
ENVIRONMENT=development

KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=notification-events
KAFKA_CONSENT_TOPIC=consent-events
KAFKA_AUDIT_TOPIC=audit-events

TENANT_SERVICE_URL=http://tenant-service:8080
MIDTRANS_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/payments/midtrans/notification
MIDTRANS_URL=https://api.sandbox.midtrans.com

# Manjo QRIS (manjo.co.id). Per-tenant credentials (client ID/secret, merchant
# ID) live in tenant-service; these are the API base URLs per environment
# (without the /v1.0 path).
# Callback base URL to give Manjo: <public API URL>/api/v1/webhooks/payments/manjo
# (Manjo appends /v1.0/access-token/b2b and /v1.0/qr/qr-mpm-notify itself).
MANJO_SANDBOX_BASE_URL=https://sandbox-api.manjo.co.id
MANJO_PRODUCTION_BASE_URL=https://api.manjo.co.id
# Public IP of this service, sent as X-IP-ADDRESS (Manjo may whitelist it)
MANJO_MERCHANT_IP=
# RSA keys as ONE LINE of base64: the PEM body without the -----BEGIN/END-----
# lines, no quotes. scripts/start-all.sh loads this file with
# `export $(grep -v '^#' .env | xargs)`, which breaks on quotes and spaces, so
# multi-line or quoted PEM does not survive it. Convert a PEM file with:
#   grep -v -- '-----' key.pem | tr -d '\n'
# (Real PEM, multi-line, is also accepted when the variable is set by Docker/k8s.)
# Platform private key that signs our access token requests to Manjo; Manjo
# holds the matching public key.
MANJO_PRIVATE_KEY=
# Manjo's public keys, per environment, verifying the access token request
# Manjo sends us before each payment notification.
MANJO_SANDBOX_PUBLIC_KEY=
MANJO_PRODUCTION_PUBLIC_KEY=

# Observability
OTEL_COLLECTOR_ENDPOINT=otel-collector:4317

# Vault Configuration (UU PDP Encryption)
VAULT_ADDR=https://localhost:8200
VAULT_TOKEN=hvs.XXX
VAULT_TRANSIT_KEY=YOUR-TRANSIT-KEY-HERE
VAULT_CACERT=<path_to_ca_certificate>

# Timezone Configuration
TZ=Asia/Jakarta
