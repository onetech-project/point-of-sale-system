# Billing Service Configuration

# Server
PORT=8090
SERVICE_NAME=billing-service

# Database
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_db?sslmode=disable

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notification-events
KAFKA_AUDIT_TOPIC=audit-events

# Redis cache invalidation for API Gateway subscription checks
REDIS_HOST=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=pos_password

# Product photo object storage cleanup (optional but recommended)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=product-photos
S3_REGION=us-east-1
S3_USE_SSL=false

# Midtrans platform credentials for tenant subscription payments
MIDTRANS_SERVER_KEY=YOUR_SERVER_KEY_HERE
MIDTRANS_ENV=sandbox
# Public gateway webhook URL used as Midtrans X-Override-Notification per transaction.
# For local testing with real callbacks, use a public tunnel such as ngrok/cloudflared.
MIDTRANS_WEBHOOK_URL=https://your-public-domain.example.com/api/v1/billing/webhook

# Billing plan config
PLAN_MONTHLY_PRICE_IDR=299000
PLAN_ANNUAL_DISCOUNT_PCT=20
PLAN_TRIAL_DAYS=7
PLAN_GRACE_PERIOD_DAYS=7
PLAN_RETENTION_DAYS=30

# Browser-reachable frontend URL for invoice/payment links and Midtrans finish redirects.
# Configure Midtrans Snap Finish/Unfinish/Error Redirect URLs to:
# ${FRONTEND_DOMAIN}/subscription?payment_return=midtrans
FRONTEND_DOMAIN=http://localhost:3000
