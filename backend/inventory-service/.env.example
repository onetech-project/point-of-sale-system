# Inventory Service Environment Configuration

# Server
PORT=8080

# Database
DATABASE_URL=postgresql://pos_user:pos_password@postgres:5432/pos_db?sslmode=disable

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_CONSUMER_GROUP=inventory-service-order-consumer

# Service metadata
SERVICE_NAME=inventory-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Timezone
TZ=Asia/Jakarta
